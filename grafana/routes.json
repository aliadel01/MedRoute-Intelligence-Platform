      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Hospitals & Dispatch Routes",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT latitude, longitude, name, icu_beds\nFROM hospitals\n-- WHERE ('$selected_incident' = 'All')\n--   OR (name = (SELECT target_hospital_name FROM dispatched_routes WHERE incident_id = '$selected_incident'));",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \n    incident_lat AS latitude,\n    incident_lon AS longitude,\n    severity, \n    target_hospital_name, \n    travel_duration_seconds / 60.0 AS \"duration (m)\", \n    travel_distance_meters / 1000.0 AS \"distance (km)\"\nFROM dispatched_routes\nWHERE ('$selected_incident' = 'All') OR (incident_id = '$selected_incident')\nORDER BY processed_at DESC\nLIMIT 5;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  point_order AS seq,\n  (point->>1)::double precision AS latitude,\n  (point->>0)::double precision AS longitude\nFROM (\n  SELECT route_geometry, incident_id,\n         ROW_NUMBER() OVER (ORDER BY processed_at DESC) AS rn\n  FROM dispatched_routes\n) r\nCROSS JOIN LATERAL jsonb_array_elements(\n  replace(r.route_geometry, '''', '\"')::jsonb -> 'coordinates'\n) WITH ORDINALITY AS t(point, point_order)\nWHERE ( '$selected_incident' = 'All' AND r.rn = 1 )\n   OR ( '$selected_incident' != 'All' AND r.incident_id = '$selected_incident' )\nORDER BY point_order;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
